{
  "openapi": "3.1.0",
  "info": {
    "title": "MIDI Agent API",
    "description": "AI-powered MIDI generation from natural language prompts",
    "version": "0.1.0"
  },
  "paths": {
    "/api/midi/generate": {
      "post": {
        "tags": [
          "midi"
        ],
        "summary": "Generate Midi",
        "description": "Generate MIDI events from a natural language prompt.\n\nArgs:\n    request: Generation request with thread_id, constraints, and prompt\n    db: Database session\n    user_id: User ID from Authorization header\n\nReturns:\n    MidiResponse with plan and list of MIDI events\n\nRaises:\n    HTTPException: If generation fails",
        "operationId": "generate_midi_api_midi_generate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GenerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MidiResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/midi/restore": {
      "post": {
        "tags": [
          "midi"
        ],
        "summary": "Restore Conversation",
        "description": "Restore a previous conversation by thread_id.\n\nArgs:\n    request: Restore request with thread_id\n    db: Database session\n    user_id: User ID from Authorization header\n\nReturns:\n    ConversationRestoreResponse with full conversation history\n\nRaises:\n    HTTPException: If conversation not found or retrieval fails",
        "operationId": "restore_conversation_api_midi_restore_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConversationRestoreRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConversationRestoreResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/midi/render": {
      "post": {
        "tags": [
          "midi"
        ],
        "summary": "Render Midi",
        "description": "Render MIDI events to audio.\n\nArgs:\n    request: Render request with BPM and MIDI events\n\nReturns:\n    RenderResponse with audio URL, duration, and sample rate\n\nRaises:\n    HTTPException: If rendering fails",
        "operationId": "render_midi_api_midi_render_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenderResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/midi/songs/": {
      "get": {
        "tags": [
          "midi"
        ],
        "summary": "List Songs",
        "description": "List all songs for the current user.\n\nArgs:\n    db: Database session\n    user_id: User ID from Authorization header\n\nReturns:\n    List of SongResponse objects\n\nRaises:\n    HTTPException: If retrieval fails",
        "operationId": "list_songs_api_midi_songs__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SongResponse"
                  },
                  "type": "array",
                  "title": "Response List Songs Api Midi Songs  Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "midi"
        ],
        "summary": "Create Song",
        "description": "Create a new song with an empty track.\n\nArgs:\n    request: Song creation request with title, bpm, and key\n    db: Database session\n    user_id: User ID from Authorization header\n\nReturns:\n    SongResponse with the new song and its empty track\n\nRaises:\n    HTTPException: If creation fails",
        "operationId": "create_song_api_midi_songs__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSongRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SongResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/midi/songs/{song_id}": {
      "get": {
        "tags": [
          "midi"
        ],
        "summary": "Get Song",
        "description": "Get a specific song with all track details and loops.\n\nArgs:\n    song_id: Song identifier (path parameter)\n    db: Database session\n    user_id: User ID from Authorization header\n\nReturns:\n    SongResponse with tracks and loops\n\nRaises:\n    HTTPException: If song not found or access denied",
        "operationId": "get_song_api_midi_songs__song_id__get",
        "parameters": [
          {
            "name": "song_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Song Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SongResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/midi/loops/{loop_id}/chats": {
      "get": {
        "tags": [
          "midi"
        ],
        "summary": "Get Loop Chats",
        "description": "Get complete chat history for a specific loop.\n\nArgs:\n    loop_id: Loop identifier (path parameter)\n    db: Database session\n\nReturns:\n    ChatHistoryResponse with all messages\n\nRaises:\n    HTTPException: If loop not found",
        "operationId": "get_loop_chats_api_midi_loops__loop_id__chats_get",
        "parameters": [
          {
            "name": "loop_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Loop Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatHistoryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Health check endpoint.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Check Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatHistoryResponse": {
        "properties": {
          "loop_id": {
            "type": "string",
            "title": "Loop Id",
            "description": "Loop ID"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessageResponse"
            },
            "type": "array",
            "title": "Messages",
            "description": "Chat messages in chronological order"
          },
          "message_count": {
            "type": "integer",
            "title": "Message Count",
            "description": "Total number of messages"
          }
        },
        "type": "object",
        "required": [
          "loop_id",
          "messages",
          "message_count"
        ],
        "title": "ChatHistoryResponse",
        "description": "Response model for chat history."
      },
      "ChatMessageResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Chat message ID"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "Message role: 'user' or 'assistant'"
          },
          "msg": {
            "type": "string",
            "title": "Msg",
            "description": "Message content"
          },
          "midi_events": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Midi Events",
            "description": "MIDI events (if any)"
          },
          "loop_id": {
            "type": "string",
            "title": "Loop Id",
            "description": "ID of the associated loop"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "ISO timestamp of message creation"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At",
            "description": "ISO timestamp of last update"
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "msg",
          "loop_id",
          "created_at",
          "updated_at"
        ],
        "title": "ChatMessageResponse",
        "description": "Response model for chat messages."
      },
