        "type": "object",
        "required": [
          "user_id",
          "thread_id",
          "messages",
          "message_count"
        ],
        "title": "ConversationRestoreResponse",
        "description": "Response containing conversation history."
      },
      "CreateSongRequest": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title",
            "description": "Song title (optional)"
          },
          "bpm": {
            "type": "integer",
            "exclusiveMaximum": 361.0,
            "exclusiveMinimum": 29.0,
            "title": "Bpm",
            "description": "Tempo in BPM (30-360)"
          },
          "key": {
            "type": "string",
            "enum": [
              "Ab",
              "A",
              "A#",
              "Bb",
              "B",
              "C",
              "C#",
              "Db",
              "D",
              "D#",
              "Eb",
              "E",
              "F",
              "F#",
              "Gb",
              "G",
              "G#"
            ],
            "title": "Key",
            "description": "Musical key"
          }
        },
        "type": "object",
        "required": [
          "bpm",
          "key"
        ],
        "title": "CreateSongRequest",
        "description": "Request payload for creating a new song."
      },
      "GenerateRequest": {
        "properties": {
          "thread_id": {
            "type": "string",
            "format": "uuid",
            "title": "Thread Id",
            "description": "Thread identifier for conversation context"
          },
          "plan_model": {
            "type": "string",
            "enum": [
              "claude-haiku-4-5",
              "claude-sonnet-4-5",
              "gpt-4o-mini",
              "gpt-4o",
              "gpt-5-2",
              "gpt-5-mini",
              "gpt-5-nano"
            ],
            "title": "Plan Model",
            "description": "Model to use for the planning stage"
          },
          "generate_model": {
            "type": "string",
            "enum": [
              "claude-haiku-4-5",
              "claude-sonnet-4-5",
              "gpt-4o-mini",
              "gpt-4o",
              "gpt-5-2",
              "gpt-5-mini",
              "gpt-5-nano"
            ],
            "title": "Generate Model",
            "description": "Model to use for the generation stage"
          },
          "key": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "Ab",
                  "A",
                  "A#",
                  "Bb",
                  "B",
                  "C",
                  "C#",
                  "Db",
                  "D",
                  "D#",
                  "Eb",
                  "E",
                  "F",
                  "F#",
                  "Gb",
                  "G",
                  "G#"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Key",
            "description": "Musical key constraint"
          },
          "bpm": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMaximum": 361.0,
                "exclusiveMinimum": 29.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Bpm",
            "description": "Tempo constraint in BPM (30-360)"
          },
          "time_signature": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "3/4",
                  "4/4",
                  "5/4",
                  "6/8",
                  "7/8"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Time Signature",
            "description": "Time signature constraint"
          },
          "measures": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMaximum": 33.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Measures",
            "description": "Number of measures to generate (1-32)"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "title": "Prompt",
            "description": "User's musical generation request"
          }
        },
        "type": "object",
        "required": [
          "thread_id",
          "plan_model",
          "generate_model",
          "prompt"
        ],
        "title": "GenerateRequest",
        "description": "Request payload for /api/midi/generate endpoint."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoopResponse": {
        "properties": {
          "id": {
            "type": "string",
