{
  "openapi": "3.1.0",
  "info": {
    "title": "MIDI Agent API",
    "description": "AI-powered MIDI generation from natural language prompts",
    "version": "0.1.0"
  },
  "paths": {
    "/api/midi/songs/": {
      "get": {
        "tags": ["midi"],
        "summary": "List Songs",
        "description": "List all songs for the current user.\n\nArgs:\n    db: Database session\n    user_id: User ID from Authorization header\n\nReturns:\n    List of SongResponse objects\n\nRaises:\n    HTTPException: If retrieval fails",
        "operationId": "list_songs_api_midi_songs__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SongResponse"
                  },
                  "type": "array",
                  "title": "Response List Songs Api Midi Songs  Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["midi"],
        "summary": "Create Song",
        "description": "Create a new song with an empty track.",
        "operationId": "create_song_api_midi_songs__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSongRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SongDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/midi/songs/{song_id}": {
      "get": {
        "tags": ["midi"],
        "summary": "Get Song",
        "description": "Get a specific song with all track details and loops.\n\nArgs:\n    song_id: Song identifier (path parameter)\n    db: Database session\n    user_id: User ID from Authorization header\n\nReturns:\n    SongDetailResponse with tracks and loops\n\nRaises:\n    HTTPException: If song not found or access denied",
        "operationId": "get_song_api_midi_songs__song_id__get",
        "parameters": [
          {
            "name": "song_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Song Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SongDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/midi/instruments": {
      "get": {
        "tags": ["audio"],
        "summary": "List Instruments",
        "description": "List all instrument samples in the public/instruments folder.",
        "operationId": "list_instruments_api_midi_instruments_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListInstrumentsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/midi/loops/": {
      "post": {
        "tags": ["loops"],
        "summary": "Create Loop",
        "description": "Create a new MIDI loop.",
        "operationId": "create_loop_api_midi_loops__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLoopRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoopDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/midi/loops/{loop_id}": {
      "get": {
        "tags": ["loops"],
        "summary": "Get Loop",
        "description": "Get a specific loop with all chat messages.",
        "operationId": "get_loop_api_midi_loops__loop_id__get",
        "parameters": [
          {
            "name": "loop_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Loop Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoopDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["loops"],
        "summary": "Delete Loop",
        "description": "Delete a loop and all associated chat messages.\n\nThe chat messages are automatically deleted via cascade relationship.",
        "operationId": "delete_loop_api_midi_loops__loop_id__delete",
        "parameters": [
          {
            "name": "loop_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Loop Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["loops"],
        "summary": "Update Loop",
        "description": "Update a loop's offset, repeat, or track_id.\nAll fields are optional - only provided fields will be updated.",
        "operationId": "update_loop_api_midi_loops__loop_id__patch",
        "parameters": [
          {
            "name": "loop_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Loop Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchLoopRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoopResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/midi/loops/{loop_id}/chats": {
      "post": {
        "tags": ["loops"],
        "summary": "Append Chat",
        "description": "Create a new user chat message for a loop.",
        "operationId": "append_chat_api_midi_loops__loop_id__chats_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppendChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoopDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/midi/tracks/": {
      "post": {
        "tags": ["tracks"],
        "summary": "Create Track",
        "description": "Create a new MIDI track for a song.\n\nThe MIDI channel is automatically assigned as the next available channel\nbased on existing tracks in the song (max channel + 1).",
        "operationId": "create_track_api_midi_tracks__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTrackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/midi/tracks/{track_id}": {
      "delete": {
        "tags": ["tracks"],
        "summary": "Delete Track",
        "description": "Delete a track and all associated loops.\n\nThe loops are automatically deleted via cascade relationship.",
        "operationId": "delete_track_api_midi_tracks__track_id__delete",
        "parameters": [
          {
            "name": "track_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Track Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["tracks"],
        "summary": "Update Track",
        "description": "Update a track's title and/or MIDI channel.\nBoth fields are optional - only provided fields will be updated.",
        "operationId": "update_track_api_midi_tracks__track_id__patch",
        "parameters": [
          {
            "name": "track_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Track Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchTrackRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Health check endpoint.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Check Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppendChatRequest": {
        "properties": {
          "loop_id": {
            "type": "string",
            "title": "Loop Id",
            "description": "ID of the loop to add the chat message to"
          },
          "msg": {
            "type": "string",
            "minLength": 1,
            "title": "Msg",
            "description": "User message content"
          },
          "measures": {
            "type": "integer",
            "maximum": 32.0,
            "minimum": 1.0,
            "title": "Measures",
            "description": "Number of measures in the loop (1-32)"
          }
        },
        "type": "object",
        "required": ["loop_id", "msg", "measures"],
        "title": "AppendChatRequest",
        "description": "Request model for appending a new chat message to a loop."
      },
      "ChatMessageResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Chat message ID"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "Message role: 'user' or 'assistant'"
          },
          "msg": {
            "type": "string",
            "title": "Msg",
            "description": "Message content"
          },
          "midi_events": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Midi Events",
            "description": "MIDI events (if any)"
          },
          "loop_id": {
            "type": "string",
            "title": "Loop Id",
            "description": "ID of the associated loop"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "ISO timestamp of message creation"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At",
            "description": "ISO timestamp of last update"
          }
        },
        "type": "object",
        "required": ["id", "role", "msg", "loop_id", "created_at", "updated_at"],
        "title": "ChatMessageResponse",
        "description": "Response model for chat messages."
      },
      "CreateLoopRequest": {
        "properties": {
          "track_id": {
            "type": "string",
            "title": "Track Id",
            "description": "ID of the parent track"
          },
          "measures": {
            "type": "integer",
            "maximum": 32.0,
            "minimum": 0.0,
            "title": "Measures",
            "description": "Number of measures in the loop (1-32)"
          },
          "repeat": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Repeat",
            "description": "Number of times to repeat the loop (default: 1)",
            "default": 1
          }
        },
        "type": "object",
        "required": ["track_id", "measures"],
        "title": "CreateLoopRequest",
        "description": "Request model for creating a new loop."
      },
      "CreateSongRequest": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title",
            "description": "Song title (optional)"
          },
          "bpm": {
            "type": "integer",
            "exclusiveMaximum": 361.0,
            "exclusiveMinimum": 29.0,
            "title": "Bpm",
            "description": "Tempo in BPM (30-360)"
          },
          "key": {
            "type": "string",
            "enum": ["Ab", "A", "A#", "Bb", "B", "C", "C#", "Db", "D", "D#", "Eb", "E", "F", "F#", "Gb", "G", "G#"],
            "title": "Key",
            "description": "Musical key"
          },
          "time_signature": {
            "type": "string",
            "enum": ["3/4", "4/4", "5/4", "6/8", "7/8"],
            "title": "Time Signature",
            "description": "Time signature"
          }
        },
        "type": "object",
        "required": ["bpm", "key", "time_signature"],
        "title": "CreateSongRequest",
        "description": "Request payload for creating a new song."
      },
      "CreateTrackRequest": {
        "properties": {
          "song_id": {
            "type": "string",
            "title": "Song Id",
            "description": "ID of the parent song"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title",
            "description": "Track title"
          }
        },
        "type": "object",
        "required": ["song_id", "title"],
        "title": "CreateTrackRequest",
        "description": "Request model for creating a new track."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InstrumentResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Instrument ID"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Instrument title"
          },
          "type": {
            "type": "string",
            "enum": ["piano", "bass", "drum"],
            "title": "Type",
            "description": "Instrument type"
          },
          "license_type": {
            "type": "string",
            "enum": ["GNU_GPL_V3", "BSD3"],
            "title": "License Type",
            "description": "Instrument license type"
          },
          "license_uri": {
            "type": "string",
            "title": "License Uri",
            "description": "Instrument license URI"
          },
          "samples": {
            "items": {
              "$ref": "#/components/schemas/InstrumentSampleResponse"
            },
            "type": "array",
            "title": "Samples",
            "description": "Instrument samples"
          }
        },
        "type": "object",
        "required": ["id", "title", "type", "license_type", "license_uri", "samples"],
        "title": "InstrumentResponse",
        "description": "Response model for instruments."
      },
      "InstrumentSampleResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Sample ID"
          },
          "uri": {
            "type": "string",
