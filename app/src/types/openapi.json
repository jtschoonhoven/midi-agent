{
  "openapi": "3.1.0",
  "info": {
    "title": "MIDI Agent API",
    "description": "AI-powered MIDI generation from natural language prompts",
    "version": "0.1.0"
  },
  "paths": {
    "/api/midi/songs/": {
      "get": {
        "tags": [
          "midi"
        ],
        "summary": "List Songs",
        "description": "List all songs for the current user.\n\nArgs:\n    db: Database session\n    user_id: User ID from Authorization header\n\nReturns:\n    List of SongResponse objects\n\nRaises:\n    HTTPException: If retrieval fails",
        "operationId": "list_songs_api_midi_songs__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SongResponse"
                  },
                  "type": "array",
                  "title": "Response List Songs Api Midi Songs  Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "midi"
        ],
        "summary": "Create Song",
        "description": "Create a new song with an empty track.\n\nArgs:\n    request: Song creation request with title, bpm, and key\n    db: Database session\n    user_id: User ID from Authorization header\n\nReturns:\n    SongDetailResponse with the new song and its empty track\n\nRaises:\n    HTTPException: If creation fails",
        "operationId": "create_song_api_midi_songs__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSongRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SongDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/midi/songs/{song_id}": {
      "get": {
        "tags": [
          "midi"
        ],
        "summary": "Get Song",
        "description": "Get a specific song with all track details and loops.\n\nArgs:\n    song_id: Song identifier (path parameter)\n    db: Database session\n    user_id: User ID from Authorization header\n\nReturns:\n    SongDetailResponse with tracks and loops\n\nRaises:\n    HTTPException: If song not found or access denied",
        "operationId": "get_song_api_midi_songs__song_id__get",
        "parameters": [
          {
            "name": "song_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Song Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SongDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/midi/render": {
      "post": {
        "tags": [
          "audio"
        ],
        "summary": "Render Midi",
        "description": "Render MIDI events to audio.\n\nArgs:\n    request: Render request with BPM and MIDI events\n\nReturns:\n    RenderResponse with audio URL, duration, and sample rate\n\nRaises:\n    HTTPException: If rendering fails",
        "operationId": "render_midi_api_midi_render_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenderRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RenderResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/midi/loops/": {
      "post": {
        "tags": [
          "loops"
        ],
        "summary": "Create Loop",
        "description": "Create a new MIDI loop.",
        "operationId": "create_loop_api_midi_loops__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateLoopRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoopDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/midi/loops/{loop_id}": {
      "get": {
        "tags": [
          "loops"
        ],
        "summary": "Get Loop",
        "description": "Get a specific loop with all chat messages.",
        "operationId": "get_loop_api_midi_loops__loop_id__get",
        "parameters": [
          {
            "name": "loop_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Loop Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoopDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "loops"
        ],
        "summary": "Delete Loop",
        "description": "Delete a loop and all associated chat messages.\n\nThe chat messages are automatically deleted via cascade relationship.",
        "operationId": "delete_loop_api_midi_loops__loop_id__delete",
        "parameters": [
          {
            "name": "loop_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Loop Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Delete Loop Api Midi Loops  Loop Id  Delete"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/midi/loops/{loop_id}/chats": {
      "post": {
        "tags": [
          "loops"
        ],
        "summary": "Append Chat",
        "description": "Create a new user chat message for a loop.",
        "operationId": "append_chat_api_midi_loops__loop_id__chats_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppendChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoopDetailResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Health check endpoint.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Check Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppendChatRequest": {
        "properties": {
          "loop_id": {
            "type": "string",
            "title": "Loop Id",
            "description": "ID of the loop to add the chat message to"
          },
          "msg": {
            "type": "string",
            "minLength": 1,
            "title": "Msg",
            "description": "User message content"
          }
        },
        "type": "object",
        "required": [
          "loop_id",
          "msg"
        ],
        "title": "AppendChatRequest",
        "description": "Request model for appending a new chat message to a loop."
      },
      "ChatMessageResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Chat message ID"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "Message role: 'user' or 'assistant'"
          },
          "msg": {
            "type": "string",
            "title": "Msg",
            "description": "Message content"
          },
          "midi_events": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Midi Events",
            "description": "MIDI events (if any)"
          },
          "loop_id": {
            "type": "string",
            "title": "Loop Id",
            "description": "ID of the associated loop"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "ISO timestamp of message creation"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At",
            "description": "ISO timestamp of last update"
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "msg",
          "loop_id",
          "created_at",
          "updated_at"
        ],
        "title": "ChatMessageResponse",
        "description": "Response model for chat messages."
      },
      "CreateLoopRequest": {
        "properties": {
          "track_id": {
            "type": "string",
            "title": "Track Id",
            "description": "ID of the parent track"
          },
          "measures": {
            "type": "integer",
            "maximum": 33.0,
            "exclusiveMinimum": 0.0,
            "title": "Measures",
            "description": "Number of measures in the loop (1-32)"
          },
          "repeat": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Repeat",
            "description": "Number of times to repeat the loop (default: 1)",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "track_id",
          "measures"
        ],
        "title": "CreateLoopRequest",
        "description": "Request model for creating a new loop."
      },
      "CreateSongRequest": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title",
            "description": "Song title (optional)"
          },
          "bpm": {
            "type": "integer",
            "exclusiveMaximum": 361.0,
            "exclusiveMinimum": 29.0,
            "title": "Bpm",
            "description": "Tempo in BPM (30-360)"
          },
          "key": {
            "type": "string",
            "enum": [
              "Ab",
              "A",
              "A#",
              "Bb",
              "B",
              "C",
              "C#",
              "Db",
              "D",
              "D#",
              "Eb",
              "E",
              "F",
              "F#",
              "Gb",
              "G",
              "G#"
            ],
            "title": "Key",
            "description": "Musical key"
          }
        },
        "type": "object",
        "required": [
          "bpm",
          "key"
        ],
        "title": "CreateSongRequest",
        "description": "Request payload for creating a new song."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoopDetailResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Loop ID"
          },
          "measures": {
            "type": "integer",
            "title": "Measures",
            "description": "Number of measures in the loop"
          },
          "repeat": {
            "type": "integer",
            "title": "Repeat",
            "description": "Number of times to repeat the loop"
          },
          "midi_events": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Midi Events",
            "description": "MIDI events in the loop"
          },
          "track_id": {
            "type": "string",
            "title": "Track Id",
            "description": "ID of the parent track"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "ISO timestamp of creation"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At",
            "description": "ISO timestamp of last update"
          },
          "chats": {
            "items": {
              "$ref": "#/components/schemas/ChatMessageResponse"
            },
            "type": "array",
            "title": "Chats",
            "description": "Chat messages in chronological order"
          }
        },
        "type": "object",
        "required": [
          "id",
          "measures",
          "repeat",
          "midi_events",
          "track_id",
          "created_at",
          "updated_at"
        ],
        "title": "LoopDetailResponse",
        "description": "Response model for MIDI loops, including chat message history."
      },
      "LoopResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Loop ID"
          },
          "measures": {
            "type": "integer",
            "title": "Measures",
            "description": "Number of measures in the loop"
          },
          "repeat": {
            "type": "integer",
            "title": "Repeat",
            "description": "Number of times to repeat the loop"
          },
          "midi_events": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Midi Events",
            "description": "MIDI events in the loop"
          },
          "track_id": {
            "type": "string",
            "title": "Track Id",
            "description": "ID of the parent track"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "ISO timestamp of creation"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At",
            "description": "ISO timestamp of last update"
          }
        },
        "type": "object",
        "required": [
          "id",
          "measures",
          "repeat",
          "midi_events",
          "track_id",
          "created_at",
          "updated_at"
        ],
        "title": "LoopResponse",
        "description": "Response model for MIDI loops, excluding chat message history."
      },
      "MidiEvent": {
        "properties": {
          "chord": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "I",
                  "II",
                  "III",
                  "IV",
                  "V",
                  "VI",
                  "VII",
                  "V7",
                  "I7",
                  "IV7",
                  "VI7",
                  "IIdim",
                  "VIIdim",
                  "Vdim",
                  "Vsus4",
                  "Isus4",
                  "Vsus2"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Chord",
            "description": "Underlying chord in the progression (does not necessarily match the current note)"
          },
          "measure": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Measure",
            "description": "The measure, starting from 1"
          },
          "beat": {
            "type": "integer",
            "exclusiveMaximum": 9.0,
            "exclusiveMinimum": 0.0,
            "title": "Beat",
            "description": "The beat within the measure, starting from 1"
          },
          "beat_div4": {
            "type": "integer",
            "exclusiveMaximum": 9.0,
            "exclusiveMinimum": 0.0,
            "title": "Beat Div4",
            "description": "Divides the beat into quarters (16th notes)"
          },
          "beat_div16": {
            "type": "integer",
            "exclusiveMaximum": 9.0,
            "exclusiveMinimum": 0.0,
            "title": "Beat Div16",
            "description": "Divides the beat into 16ths (64th notes)"
          },
          "event": {
