          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "description": "Health check endpoint.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Check Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppendChatRequest": {
        "properties": {
          "loop_id": {
            "type": "string",
            "title": "Loop Id",
            "description": "ID of the loop to add the chat message to"
          },
          "msg": {
            "type": "string",
            "minLength": 1,
            "title": "Msg",
            "description": "User message content"
          },
          "measures": {
            "type": "integer",
            "maximum": 32.0,
            "minimum": 1.0,
            "title": "Measures",
            "description": "Number of measures in the loop (1-32)"
          }
        },
        "type": "object",
        "required": [
          "loop_id",
          "msg",
          "measures"
        ],
        "title": "AppendChatRequest",
        "description": "Request model for appending a new chat message to a loop."
      },
      "ChatMessageResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Chat message ID"
          },
          "role": {
            "type": "string",
            "title": "Role",
            "description": "Message role: 'user' or 'assistant'"
          },
          "msg": {
            "type": "string",
            "title": "Msg",
            "description": "Message content"
          },
          "midi_events": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Midi Events",
            "description": "MIDI events (if any)"
          },
          "loop_id": {
            "type": "string",
            "title": "Loop Id",
            "description": "ID of the associated loop"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "ISO timestamp of message creation"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At",
            "description": "ISO timestamp of last update"
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "msg",
          "loop_id",
          "created_at",
          "updated_at"
        ],
        "title": "ChatMessageResponse",
        "description": "Response model for chat messages."
      },
      "CreateLoopRequest": {
        "properties": {
          "track_id": {
            "type": "string",
            "title": "Track Id",
            "description": "ID of the parent track"
          },
          "measures": {
            "type": "integer",
            "maximum": 32.0,
            "minimum": 0.0,
            "title": "Measures",
            "description": "Number of measures in the loop (1-32)"
          },
          "repeat": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Repeat",
            "description": "Number of times to repeat the loop (default: 1)",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "track_id",
          "measures"
        ],
        "title": "CreateLoopRequest",
        "description": "Request model for creating a new loop."
      },
      "CreateSongRequest": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title",
            "description": "Song title (optional)"
          },
          "bpm": {
            "type": "integer",
            "exclusiveMaximum": 361.0,
            "exclusiveMinimum": 29.0,
            "title": "Bpm",
            "description": "Tempo in BPM (30-360)"
          },
          "key": {
            "type": "string",
            "enum": [
              "Ab",
              "A",
              "A#",
              "Bb",
              "B",
              "C",
              "C#",
              "Db",
              "D",
              "D#",
              "Eb",
              "E",
              "F",
              "F#",
              "Gb",
              "G",
              "G#"
            ],
            "title": "Key",
            "description": "Musical key"
          },
          "time_signature": {
            "type": "string",
            "enum": [
              "3/4",
              "4/4",
              "5/4",
              "6/8",
              "7/8"
            ],
            "title": "Time Signature",
            "description": "Time signature"
          }
        },
        "type": "object",
        "required": [
          "bpm",
          "key",
          "time_signature"
        ],
        "title": "CreateSongRequest",
        "description": "Request payload for creating a new song."
      },
      "CreateTrackRequest": {
        "properties": {
          "song_id": {
            "type": "string",
            "title": "Song Id",
            "description": "ID of the parent song"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title",
            "description": "Track title"
          }
        },
        "type": "object",
        "required": [
          "song_id",
          "title"
        ],
        "title": "CreateTrackRequest",
        "description": "Request model for creating a new track."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoopDetailResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Loop ID"
          },
          "offset": {
            "type": "integer",
            "title": "Offset",
            "description": "Position offset in measures from start of song"
          },
          "measures": {
            "type": "integer",
            "title": "Measures",
            "description": "Number of measures in the loop"
          },
          "repeat": {
            "type": "integer",
            "title": "Repeat",
            "description": "Number of times to repeat the loop"
          },
          "midi_events": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Midi Events",
            "description": "MIDI events in the loop"
          },
          "track_id": {
            "type": "string",
            "title": "Track Id",
            "description": "ID of the parent track"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "ISO timestamp of creation"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At",
            "description": "ISO timestamp of last update"
          },
          "chats": {
            "items": {
              "$ref": "#/components/schemas/ChatMessageResponse"
            },
            "type": "array",
            "title": "Chats",
            "description": "Chat messages in chronological order"
          }
        },
        "type": "object",
        "required": [
          "id",
          "offset",
          "measures",
          "repeat",
          "midi_events",
          "track_id",
          "created_at",
          "updated_at"
        ],
        "title": "LoopDetailResponse",
        "description": "Response model for MIDI loops, including chat message history."
      },
      "LoopResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Loop ID"
          },
          "offset": {
            "type": "integer",
            "title": "Offset",
            "description": "Position offset in measures from start of song"
          },
          "measures": {
            "type": "integer",
            "title": "Measures",
            "description": "Number of measures in the loop"
          },
          "repeat": {
            "type": "integer",
            "title": "Repeat",
            "description": "Number of times to repeat the loop"
          },
          "midi_events": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Midi Events",
            "description": "MIDI events in the loop"
          },
          "track_id": {
            "type": "string",
            "title": "Track Id",
            "description": "ID of the parent track"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "ISO timestamp of creation"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At",
            "description": "ISO timestamp of last update"
          }
        },
        "type": "object",
        "required": [
          "id",
          "offset",
          "measures",
          "repeat",
          "midi_events",
          "track_id",
          "created_at",
          "updated_at"
        ],
        "title": "LoopResponse",
        "description": "Response model for MIDI loops, excluding chat message history."
      },
      "PatchLoopRequest": {
        "properties": {
          "offset": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Offset",
            "description": "Position offset in measures (optional)"
          },
          "repeat": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Repeat",
            "description": "Number of times to repeat (optional)"
          },
          "track_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Track Id",
            "description": "ID of the parent track (optional)"
          }
        },
        "type": "object",
        "title": "PatchLoopRequest",
        "description": "Request model for updating a loop."
      },
      "PatchTrackRequest": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Title",
            "description": "Track title (optional)"
          },
          "midi_channel": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 16.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Midi Channel",
            "description": "MIDI channel 1-16 (optional)"
          }
        },
        "type": "object",
        "title": "PatchTrackRequest",
        "description": "Request model for updating a track."
      },
      "PublicFilesResponse": {
        "properties": {
          "public": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Public",
            "description": "List of file paths relative to the public folder"
          }
        },
        "type": "object",
        "required": [
          "public"
        ],
        "title": "PublicFilesResponse",
        "description": "Response containing list of files in the public folder."
      },
      "SongDetailResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "Song ID"
          },
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Song title"
          },
          "bpm": {
            "type": "integer",
            "title": "Bpm",
            "description": "Tempo in BPM"
          },
          "key": {
            "type": "string",
            "title": "Key",
            "description": "Musical key"
          },
          "time_signature": {
            "type": "string",
            "title": "Time Signature",
            "description": "Time signature"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "ISO timestamp of creation"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At",
            "description": "ISO timestamp of last update"
          },
          "tracks": {
            "items": {
              "$ref": "#/components/schemas/TrackDetailResponse"
            },
            "type": "array",
            "title": "Tracks",
            "description": "Tracks in this song"
          }
        },
        "type": "object",
