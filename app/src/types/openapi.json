        "required": [
          "role",
          "content",
          "created_at"
        ],
        "title": "ConversationMessage",
        "description": "A message in the conversation history."
      },
      "ConversationRestoreRequest": {
        "properties": {
          "thread_id": {
            "type": "string",
            "format": "uuid",
            "title": "Thread Id",
            "description": "Thread identifier to restore"
          }
        },
        "type": "object",
        "required": [
          "thread_id"
        ],
        "title": "ConversationRestoreRequest",
        "description": "Request to restore a conversation by thread_id."
      },
      "ConversationRestoreResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id",
            "description": "User identifier"
          },
          "thread_id": {
            "type": "string",
            "format": "uuid",
            "title": "Thread Id",
            "description": "Thread identifier"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ConversationMessage"
            },
            "type": "array",
            "title": "Messages",
            "description": "Conversation messages in chronological order"
          },
          "message_count": {
            "type": "integer",
            "title": "Message Count",
            "description": "Total number of messages"
          }
