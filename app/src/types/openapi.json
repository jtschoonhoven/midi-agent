            "type": "array",
            "title": "Midi Events",
            "description": "MIDI events in the loop"
          },
          "track_id": {
            "type": "string",
            "title": "Track Id",
            "description": "ID of the parent track"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "ISO timestamp of creation"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At",
            "description": "ISO timestamp of last update"
          }
