        "title": "MidiEvent",
        "description": "A fully resolved MIDI event with explicit timing."
      },
      "RenderRequest": {
        "properties": {
          "bpm": {
            "type": "integer",
            "exclusiveMaximum": 361.0,
            "exclusiveMinimum": 29.0,
            "title": "Bpm",
            "description": "Tempo in BPM (30-360)"
          },
          "midi": {
            "items": {
              "$ref": "#/components/schemas/MidiEvent"
            },
            "type": "array",
            "title": "Midi",
            "description": "MIDI events to render"
          }
        },
        "type": "object",
        "required": [
          "bpm",
          "midi"
        ],
        "title": "RenderRequest",
        "description": "Request payload for /api/midi/render endpoint."
      },
      "RenderResponse": {
        "properties": {
          "audio_url": {
            "type": "string",
            "title": "Audio Url",
            "description": "URL to the rendered audio file"
          },
          "duration_seconds": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Duration Seconds",
            "description": "Duration of the audio in seconds"
          },
          "sample_rate": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Sample Rate",
            "description": "Sample rate of the audio in Hz"
          }
        },
        "type": "object",
        "required": [
          "audio_url",
          "duration_seconds",
          "sample_rate"
        ],
        "title": "RenderResponse",
        "description": "Response from /api/midi/render endpoint with audio information."
      },
      "SongDetailResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
